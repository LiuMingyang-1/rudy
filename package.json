{
  "name": "rudy",
  "version": "0.1.0",
  "private": true,
  "description": "A personal agent built on pi.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LiuMingyang-1/rudy.git"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/cli.ts",
    "check": "biome check . && tsc --noEmit",
    "format": "biome check --write .",
    "test:unit": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
