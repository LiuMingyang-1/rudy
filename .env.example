# Without RUDY_BASE_URL: openai or anthropic.
# With RUDY_BASE_URL: anthropic uses Messages; other names use OpenAI Chat Completions.
RUDY_PROVIDER=openai
RUDY_MODEL=gpt-5.4
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Custom endpoint (uncomment and replace with your service settings):
# RUDY_PROVIDER=my-gateway
# RUDY_BASE_URL=https://example.com/v1
# RUDY_MODEL=your-model-id
# RUDY_API_KEY=your-api-key
# Custom endpoint token limits (positive integers; defaults shown):
# RUDY_CONTEXT_WINDOW=128000
# Ordinary reply output budget (also applies to official providers):
# RUDY_MAX_TOKENS=4096

# Session compaction (same model, independent summary output budget):
# RUDY_COMPACTION_THRESHOLD=0.8
# RUDY_COMPACTION_KEEP_RECENT_TOKENS=20000
# RUDY_COMPACTION_MAX_TOKENS=8192

# Directory exposed to Rudy's read-only file tools; relative to the launch directory.
RUDY_WORKSPACE=.
